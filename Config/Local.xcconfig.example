// Copy to Config/Local.xcconfig (gitignored) and fill in.
// Team ID: Xcode > Settings > Accounts, or `security find-identity -v -p codesigning`.
DEVELOPMENT_TEAM = ABCDE12345
// Free accounts need a bundle prefix nobody else has registered.
BUNDLE_ID_PREFIX = com.example.tailmouse
// GitHub owner/repo for the link in About.
REPO_SLUG = example/tailmouse
